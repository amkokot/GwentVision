<Window x:Class="GwentCompanion.App.DeckLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gwent Vision · Add / edit decks" Width="660" Height="730" MinWidth="460" MinHeight="560"
        Background="#171B20" Foreground="#EEF2F5"
        Topmost="False" WindowStartupLocation="Manual">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#11151A"/><Setter Property="Foreground" Value="#EEF2F5"/><Setter Property="BorderBrush" Value="#3B444F"/><Setter Property="Padding" Value="6,4"/></Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="#11151A"/><Setter Property="Foreground" Value="#EEF2F5"/><Setter Property="BorderBrush" Value="#3B444F"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
        <DataTemplate x:Key="ReadableChoice"><TextBlock Text="{Binding Label}" Foreground="#E8E0CC" TextWrapping="Wrap"/></DataTemplate>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Foreground" Value="#E8E0CC"/><Setter Property="Background" Value="#1B2428"/>
            <Setter Property="ItemTemplate" Value="{StaticResource ReadableChoice}"/>
            <Setter Property="MaxDropDownHeight" Value="280"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="TextSearch.TextPath" Value="Label"/>
        </Style>
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="Foreground" Value="#E8E0CC"/>
            <Setter Property="Background" Value="#1B2428"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
            <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#D9E7F5"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#687480"/></Trigger>
        </Style.Triggers></Style>
        <DataTemplate x:Key="EditableCardRow"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="2,3"/></DataTemplate>
    </Window.Resources>
    <TabControl Margin="10" Background="#171B20" BorderBrush="#3B444F">
        <TabItem Header="Deck editor / scan">
            <Grid Margin="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Deck name"/>
                    <TextBox x:Name="NameBox" Text="My imported deck" MaxLength="160" Margin="0,3,0,6"/>
                    <TextBlock Text="Starting leader · choose faction, then ability (or type its name)"/>
                    <Grid Margin="0,3,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="FactionBox" SelectionChanged="FactionChanged" AutomationProperties.Name="Filter starting leaders by faction"/>
                        <ComboBox x:Name="LeaderBox" Grid.Column="2" TextSearch.TextPath="Card.Name" SelectionChanged="LeaderChanged" AutomationProperties.Name="Starting leader ability"/>
                    </Grid>
                    <TextBlock Text="Stratagem (separate from the 25-card deck)"/>
                    <ComboBox x:Name="StratagemBox" Margin="0,3,0,7" SelectionChanged="StratagemChanged"/>
                    <WrapPanel>
                        <Button x:Name="ScanButton" Content="Start deck-builder scan" Click="ScanClicked"/>
                        <Button x:Name="ResetButton" Content="New / reset draft" Click="ResetClicked"/>
                        <ComboBox x:Name="PanelBox" ItemTemplate="{x:Null}" SelectedIndex="0" Width="110" Margin="0,0,0,8" VerticalContentAlignment="Center">
                            <ComboBoxItem><TextBlock Text="Left deck list" Foreground="#E8E0CC"/></ComboBoxItem><ComboBoxItem><TextBlock Text="Right deck list" Foreground="#E8E0CC"/></ComboBoxItem>
                        </ComboBox>
                    </WrapPanel>
                    <TextBlock x:Name="ScanStatus" Foreground="#AEB7C0" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Open one deck in GWENT, start scan, switch back to GWENT and scroll its deck list with short pauses. Stop to review. Premium artwork is ignored; names are read. Verify all copy counts."/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Draft · deck-builder order" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button Content="− Remove one" Click="RemoveClicked" Padding="7,5"/><Button Content="+ Copy" Click="CopyClicked" Padding="7,5"/>
                        </WrapPanel>
                        <ListBox x:Name="DraftList" ItemTemplate="{StaticResource EditableCardRow}"/>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="Search cards to add" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox DockPanel.Dock="Top" x:Name="CardSearch" TextChanged="SearchChanged" Margin="0,0,0,5"/>
                        <Button DockPanel.Dock="Bottom" Content="+ Add selected card" Click="AddClicked" Margin="0,6,0,0"/>
                        <ListBox x:Name="CardResults" ItemTemplate="{StaticResource EditableCardRow}" MouseDoubleClick="AddClicked"/>
                    </DockPanel>
                </Grid>
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <TextBlock x:Name="DraftStatus" TextWrapping="Wrap" Foreground="#E5C77E"/>
                    <ScrollViewer MaxHeight="42" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,5">
                        <TextBlock x:Name="SaveStatus" TextWrapping="Wrap" Foreground="#AEB7C0"/>
                    </ScrollViewer>
                    <WrapPanel>
                        <Button x:Name="SaveButton" Content="Confirm / save to cache" Click="SaveClicked"/>
                        <Button x:Name="RenameButton" Content="Rename only" Click="RenameClicked"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem Header="Spreadsheet / links">
            <Grid Margin="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock FontSize="16" Text="Import complete decks"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,5,0,10" Foreground="#AEB7C0"
                               Text="Choose an .xlsx / .csv / .tsv file, or paste PlayGWENT deck links below. Every unique direct deck link is checked; duplicates merge with their source links preserved. Expired links are reported. No spreadsheet formulas are executed."/>
                    <Button x:Name="FileButton" Content="Choose spreadsheet…" Click="FileClicked" HorizontalAlignment="Left"/>
                    <TextBox x:Name="LinksBox" Height="95" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#AEB7C0" Margin="0,5,0,8"
                               Text="For an exact import without scanning: use GWENT's Share deck action and paste its public /decks/… link. Online Google Sheets: download as .xlsx first. Guide links are not direct deck links."/>
                    <WrapPanel><Button x:Name="LinkButton" Content="Import pasted links" Click="LinksClicked"/>
                        <Button x:Name="CancelButton" Content="Cancel import" Click="CancelClicked" IsEnabled="False"/>
                        <Button x:Name="RetryButton" Content="Retry saved imports" Click="RetryClicked"/></WrapPanel>
                    <TextBlock x:Name="ImportStatus" TextWrapping="Wrap" Foreground="#E5C77E" Margin="0,0,0,10"/>
                </StackPanel>
                <TextBox Grid.Row="1" x:Name="ImportLog" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
