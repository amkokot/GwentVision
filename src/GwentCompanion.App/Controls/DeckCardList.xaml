<UserControl x:Class="GwentCompanion.App.Controls.DeckCardList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ListBox x:Name="CardRows" ItemsSource="{Binding Rows, RelativeSource={RelativeSource AncestorType=UserControl}}"
             Background="#101419" BorderThickness="0" Padding="0,2"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
             VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
        <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,3" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Grid><ContentPresenter />
                    <Border x:Name="SelectedOutline" BorderThickness="2" BorderBrush="Transparent" IsHitTestVisible="False"/>
                    </Grid><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectedOutline" Property="BorderBrush" Value="#F0CA73"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Button Click="Row_OnClick" MouseEnter="Row_OnInspected" GotKeyboardFocus="Row_OnInspected" Padding="0" Margin="0" BorderThickness="0" Background="Transparent"
                        AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.HelpText="{Binding Tooltip}"
                        ToolTipService.IsEnabled="False" HorizontalContentAlignment="Stretch">
                    <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Button.Template>
                <Border Height="{Binding RowHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" BorderBrush="{Binding FrameColor}" BorderThickness="1" Background="#19212A"
                        ClipToBounds="True" Opacity="{Binding RowOpacity}">
                    <Grid>
                        <Image Source="{Binding Artwork}" Width="160" HorizontalAlignment="Right" Stretch="UniformToFill" Opacity="0.72" />
                        <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF111820" Offset="0.25" /><GradientStop Color="#EF111820" Offset="0.57" />
                            <GradientStop Color="#75111820" Offset="1" />
                        </LinearGradientBrush></Rectangle.Fill></Rectangle>
                        <Border BorderBrush="{Binding StateColor}" BorderThickness="4,0,0,0" />
                        <Grid Margin="7,0,6,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Position}" FontSize="9" Foreground="#8E9AA6" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Provision}" FontSize="17" FontWeight="SemiBold" Foreground="#E5C77E" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,4,0">
                                <TextBlock Text="{Binding Name}" Foreground="#F1F3F5" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" Foreground="#C1CBD3" FontSize="9" TextTrimming="CharacterEllipsis">
                                 <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ShowDetails, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Detail}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="{Binding ValueBadge}" FontSize="11" FontWeight="Bold" Foreground="#85D7B1" TextAlignment="Right"/>
                            <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" Foreground="{Binding StateColor}" TextAlignment="Right"/></StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                </Button>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
