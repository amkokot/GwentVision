<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Charcoal surfaces and ivory type own normal, selected and editable states. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1B2428"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ScrollBarBrushKey}" Color="#11181C"/>
    <Style x:Key="DarkScrollThumb" TargetType="Thumb">
        <Setter Property="Background" Value="#61716A"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="2"/></ControlTemplate></Setter.Value></Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B39A61"/></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter Property="Background" Value="#DFC17E"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#E8E0CC"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <DockPanel Background="Transparent">
                <Border x:Name="CheckSurface" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Background="#1B2428" BorderBrush="#71818B" BorderThickness="1">
                    <Path x:Name="CheckMark" Data="M 2,5 L 4.5,8 L 9,2" Stroke="#E5C77E" StrokeThickness="1.6" Visibility="Collapsed"/>
                </Border>
                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </DockPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/><Setter TargetName="CheckMark" Property="Data" Value="M 2,5 L 9,5"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="#344540"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#E5C77E"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#AEB7C0"/><Setter TargetName="CheckSurface" Property="Opacity" Value="0.6"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DarkScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="#11181C"/><Setter Property="Width" Value="13"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"
                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}"
                       Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Style="{StaticResource DarkScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Style="{StaticResource DarkScrollThumb}"/></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Style="{StaticResource DarkScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                </Track>
            </Border>
            <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                <Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                <Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/>
            </Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="13"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="#E8E0CC"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
            <StackPanel>
                <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Stretch">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" Padding="0,3">
                        <DockPanel><Path x:Name="Chevron" Data="M 0,0 L 4,4 L 0,8" Stroke="#C6AA69" StrokeThickness="1.6" Width="10" Height="10" Margin="2,0,6,0" RenderTransformOrigin="0.5,0.5"/>
                        <ContentPresenter VerticalAlignment="Center"/></DockPanel>
                    </Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
                    <ContentPresenter ContentSource="Header"/>
                </ToggleButton>
                <ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed"/>
            </StackPanel>
            <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Style.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8E0CC"/></Style></Style.Resources>
        <Setter Property="Foreground" Value="#E8E0CC"/><Setter Property="Background" Value="#1B2428"/>
        <Setter Property="Padding" Value="7,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ChoiceSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <ContentPresenter TextElement.Foreground="#E8E0CC">
                    <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8E0CC"/></Style></ContentPresenter.Resources>
                </ContentPresenter>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="ChoiceSurface" Property="Background" Value="#344540"/></Trigger>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ChoiceSurface" Property="Background" Value="#3C4B43"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#AEB7C0"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Style.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8E0CC"/></Style></Style.Resources>
        <Setter Property="Foreground" Value="#E8E0CC"/><Setter Property="Background" Value="#1B2428"/>
        <Setter Property="BorderBrush" Value="#71818B"/><Setter Property="Padding" Value="6,4"/>
        <Setter Property="MaxDropDownHeight" Value="280"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
            <Grid>
                <Border Background="#1B2428" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                <ToggleButton x:Name="DropDownToggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><TextBlock Text="▾" Foreground="#E8E0CC" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/></Border></ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="Selection" Margin="6,4,28,4" IsHitTestVisible="False" VerticalAlignment="Center"
                    Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Foreground="#E8E0CC" Background="#1B2428" CaretBrush="#E8E0CC" SelectionBrush="#4D6455"
                         BorderThickness="0" Margin="6,4,28,4" VerticalContentAlignment="Center" Visibility="Collapsed" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                    <Border Background="#1B2428" BorderBrush="#71818B" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/><Setter TargetName="Selection" Property="Visibility" Value="Hidden"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#C49B46"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#AEB7C0"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="#EEF2F5"/><Setter Property="Background" Value="#111820"/><Setter Property="Padding" Value="5"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ListSurface" Background="{TemplateBinding Background}" BorderBrush="#111820" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="ListSurface" Property="Background" Value="#314D46"/><Setter TargetName="ListSurface" Property="BorderBrush" Value="#C4A361"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ListSurface" Property="BorderBrush" Value="#91A99E"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ListSurface" Property="BorderBrush" Value="#E5C77E"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#111820"/><Setter Property="Foreground" Value="#EEF2F5"/>
        <Setter Property="BorderBrush" Value="#60717D"/><Setter Property="CaretBrush" Value="#EEF2F5"/>
        <Setter Property="SelectionBrush" Value="#385E76"/><Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style TargetType="ToggleButton">
        <Setter Property="Foreground" Value="#EEF2F5"/><Setter Property="Background" Value="#26302F"/>
        <Setter Property="BorderBrush" Value="#71818B"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
            <Border x:Name="ToggleSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleSurface" Property="Background" Value="#344B46"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleSurface" Property="Background" Value="#41564C"/><Setter TargetName="ToggleSurface" Property="BorderBrush" Value="#E5C77E"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="#EEF2F5"/><Setter Property="Background" Value="#152125"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
            <Border Background="#152125" BorderBrush="#B99750" BorderThickness="1" Padding="4"><StackPanel IsItemsHost="True"/></Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Style.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEF2F5"/></Style></Style.Resources>
        <Setter Property="Foreground" Value="#EEF2F5"/><Setter Property="Padding" Value="10,8"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
            <Grid>
                <Border x:Name="MenuSurface" Background="#152125" Padding="{TemplateBinding Padding}">
                    <DockPanel><TextBlock x:Name="Check" Text="✓" Width="22" Visibility="Hidden"/><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></DockPanel>
                </Border>
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right" AllowsTransparency="True" Focusable="False">
                    <Border Background="#152125" BorderBrush="#B99750" BorderThickness="1" Padding="4"><StackPanel IsItemsHost="True"/></Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuSurface" Property="Background" Value="#344B46"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MenuSurface" Property="Opacity" Value="0.65"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
