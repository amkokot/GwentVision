<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,8"><Button x:Name="ClearPinnedOpponentButton" DockPanel.Dock="Right" Content="Unpin" Click="ClearOpponentDeckButton_OnClick" Padding="7,4" Margin="8,0,0,0" VerticalAlignment="Top" IsEnabled="False"/>
<TextBlock x:Name="PinnedOpponentSummary" Text="No opponent deck pinned." FontSize="12" TextWrapping="Wrap" Foreground="#E5C77E"/></DockPanel>
<Expander x:Name="ReferencePicker" Grid.Row="1" Header="Choose opponent deck" Margin="0,0,0,8">
<ScrollViewer x:Name="ReferencePickerScroll" MaxHeight="400" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<Grid x:Name="ReferenceLayout" Height="390" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel x:Name="ReferenceToolbar">
                                <ui:DeckSearchBar x:Name="ReferenceSearch" Changed="ReferenceSearch_OnChanged" ResetRequested="ReferenceSearch_OnReset"/>
                                <TextBlock x:Name="OpponentSearchStatus" Margin="0,4,0,6" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                            <ListBox x:Name="OpponentCandidateList" Grid.Row="1" MinHeight="65" Background="#11151A" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OpponentCandidateList_OnSelectionChanged">
                                <ListBox.ItemTemplate><DataTemplate><ui:DeckHeading Title="{Binding Name}" Subtitle="{Binding Context}" Faction="{Binding Deck.Faction}" Leader="{Binding Deck.Leader}"/></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="OpponentCandidateDetailText" Grid.Row="2" Margin="0,6,0,5" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="Select a list to inspect all its cards."/>
                            <ui:DeckCardList x:Name="CandidateDeckCards" Grid.Row="3"/>
                            <StackPanel x:Name="ReferenceActions" Grid.Row="4" Margin="0,7,0,0">
                                <WrapPanel>
                                    <Button x:Name="ConfirmOpponentDeckButton" IsEnabled="False" Click="ConfirmOpponentDeckButton_OnClick" Content="Pin this list"/>
                                    <Button x:Name="ClearOpponentDeckButton" Click="ClearOpponentDeckButton_OnClick" Content="Clear pin"/>
                                </WrapPanel>
                                <TextBlock x:Name="OpponentConfirmedText" FontSize="10" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DevotionAssumptionText" Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid></ScrollViewer></Expander>
<ui:DeckCardList x:Name="PinnedOpponentCards" Grid.Row="2" RowHeight="42"/>
</Grid></Grid>
<Grid x:Name="AdvancedPage" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="7,8"><TextBlock Text="ADVANCED INFORMATION" FontFamily="Georgia" Foreground="{StaticResource AccentBrush}" FontSize="16" Margin="0,0,0,8"/><TextBlock x:Name="OpponentClueText" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="#85BFFF" Visibility="Collapsed"/>
                                <TextBlock Text="RELEVANT DECK CLUES" FontWeight="SemiBold" Foreground="#85BFFF"/>
                                <ItemsControl x:Name="OpponentClues" Margin="0,6,0,8">
                                    <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,7">
                                        <TextBlock Text="{Binding Text}" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap"/>
                                    </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Expander Header="Match details / confirm a visible effect" Margin="0,0,0,10">
                                    <StackPanel Margin="0,7,0,0">
                                        <TextBlock Text="Optional corrections. Confirm successful effects, not just a card being played." FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock Text="Original leader (not a Renfri / Anna replacement)" FontSize="10" Margin="0,6,0,3"/>
                                        <ComboBox x:Name="OriginalLeaderChoice" Foreground="#E8E0CC" ItemTemplate="{StaticResource CardChoiceText}" ItemContainerStyle="{StaticResource CardChoiceItems}" IsTextSearchEnabled="True" TextSearch.TextPath="Name" MaxDropDownHeight="260" SelectionChanged="OriginalLeaderChoice_OnChanged"/>
                                        <TextBlock Text="Opening stratagem (not one created by Radeyah)" FontSize="10" Margin="0,6,0,3"/>
                                        <ComboBox x:Name="OpeningStratagemChoice" Foreground="#E8E0CC" ItemTemplate="{StaticResource CardChoiceText}" ItemContainerStyle="{StaticResource CardChoiceItems}" IsTextSearchEnabled="True" TextSearch.TextPath="Name" MaxDropDownHeight="200" SelectionChanged="OpeningStratagemChoice_OnChanged"/>
                                        <WrapPanel Margin="0,7,0,0">
                                            <TextBlock Text="Round" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <ComboBox x:Name="RoundChoice" Width="95" Foreground="#E8E0CC" SelectionChanged="RoundChoice_OnChanged">
                                                <ComboBoxItem AutomationProperties.Name="Auto / ?"><TextBlock Text="Auto / ?" Foreground="#E8E0CC"/></ComboBoxItem>
                                                <ComboBoxItem AutomationProperties.Name="1"><TextBlock Text="1" Foreground="#E8E0CC"/></ComboBoxItem>
                                                <ComboBoxItem AutomationProperties.Name="2"><TextBlock Text="2" Foreground="#E8E0CC"/></ComboBoxItem>
                                                <ComboBoxItem AutomationProperties.Name="3"><TextBlock Text="3" Foreground="#E8E0CC"/></ComboBoxItem>
                                            </ComboBox>
                                            <TextBlock Text="Starting size" VerticalAlignment="Center" Margin="8,0,5,0"/>
                                            <TextBox x:Name="StartingSizeInput" Width="40" ToolTip="Leave blank if unknown; this is the original list, not the current draw pile"/>
                                            <Button Content="Set" Padding="6,2" Margin="5,0,0,0" Click="SetStartingSize_OnClick"/>
                                        </WrapPanel>
                                        <ComboBox x:Name="ResolvedEffectChoice" Margin="0,8,0,5" Foreground="#E8E0CC" ItemTemplate="{StaticResource EffectChoiceText}" ItemContainerStyle="{StaticResource EffectChoiceItems}" MaxDropDownHeight="240"/>
                                        <WrapPanel><Button Content="Confirm effect" Click="ConfirmEffect_OnClick"/><Button Content="Undo condition" Click="UndoEffect_OnClick"/></WrapPanel>
                                        <TextBlock x:Name="OpponentKnowledgeStatus" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                                    </StackPanel>
                                </Expander>
                                <Expander x:Name="DeckChangesPanel" Header="Card origins / deck changes" Margin="0,0,0,10">
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock x:Name="DeckChangesText" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="DescriptionHintText" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="10"/>
                                        <ComboBox x:Name="AddedCardChoice" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name" ItemTemplate="{StaticResource CardChoiceText}" ItemContainerStyle="{StaticResource CardChoiceItems}" Foreground="#E8E0CC" MaxDropDownHeight="240" Margin="0,6,0,4"/>
                                        <CheckBox x:Name="DescriptionIsReveal" Content="Revealed in deck, not added (e.g. Summoning Circle)" Foreground="{StaticResource TextBrush}" FontSize="10" Margin="0,0,0,6"/>
                                        <WrapPanel>
                                            <ComboBox x:Name="AdditionSideChoice" Width="100" Foreground="#E8E0CC" SelectedIndex="0">
                                                <ComboBoxItem AutomationProperties.Name="Opponent"><TextBlock Text="Opponent" Foreground="#E8E0CC"/></ComboBoxItem>
                                                <ComboBoxItem AutomationProperties.Name="Player"><TextBlock Text="Player" Foreground="#E8E0CC"/></ComboBoxItem>
                                            </ComboBox>
                                            <Button Content="Record visible card" Click="RecordAddition_OnClick" Padding="8,4" Margin="6,0,0,0"/>
                                        </WrapPanel>
                                        <TextBlock Text="Open Henry / Temple / Summoning Circle's description to offer exact names here. Confirm the side and whether this is an addition or reveal. A current-deck reveal can still be an acquired card." FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Bookkeeping audit (optional)" Margin="0,0,0,10">
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Text="Partial graveyard inspections are logged quietly. Scroll/hover to expose names. Unassigned side and unknown origin stay ambiguous; repeated views do not add copies." FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                                        <ListBox x:Name="ZoneAuditList" MaxHeight="140" Background="#11151A" Foreground="#E8EDF2" Margin="0,6" DisplayMemberPath="Label" SelectionChanged="ZoneAuditList_OnChanged"/>
                                        <ComboBox x:Name="ZoneAuditCard" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name" ItemTemplate="{StaticResource CardChoiceText}" ItemContainerStyle="{StaticResource CardChoiceItems}" Foreground="#E8E0CC" MaxDropDownHeight="180"/>
                                        <ComboBox x:Name="ZoneAuditSide" SelectedIndex="0" Foreground="#E8E0CC" Margin="0,4">
                                            <ComboBoxItem><TextBlock Text="Side unknown" Foreground="#E8E0CC"/></ComboBoxItem>
                                            <ComboBoxItem><TextBlock Text="Opponent" Foreground="#E8E0CC"/></ComboBoxItem>
                                            <ComboBoxItem><TextBlock Text="Player" Foreground="#E8E0CC"/></ComboBoxItem>
                                        </ComboBox>
                                        <ComboBox x:Name="ZoneAuditRoute" SelectedIndex="0" Foreground="#E8E0CC" Margin="0,0,0,4">
                                            <ComboBoxItem><TextBlock Text="Entry / original origin unknown" Foreground="#E8E0CC"/></ComboBoxItem>
                                            <ComboBoxItem><TextBlock Text="Original card verified" Foreground="#E8E0CC"/></ComboBoxItem>
                                            <ComboBoxItem><TextBlock Text="Generated copy verified" Foreground="#E8E0CC"/></ComboBoxItem>
                                            <ComboBoxItem><TextBlock Text="Discarded; original origin unknown" Foreground="#E8E0CC"/></ComboBoxItem>
                                            <ComboBoxItem><TextBlock Text="Heulyn setup Human verified" Foreground="#E8E0CC"/></ComboBoxItem>
                                            <ComboBoxItem><TextBlock Text="Rioghan in opening graveyard" Foreground="#E8E0CC"/></ComboBoxItem>
                                            <ComboBoxItem><TextBlock Text="Returned to deck (target verified)" Foreground="#E8E0CC"/></ComboBoxItem>
                                        </ComboBox>
                                        <WrapPanel><Button Content="Record / correct entry" Click="RecordZoneEntry_OnClick"/><Button Content="Remove entry" Click="RemoveZoneEntry_OnClick"/></WrapPanel>
                                        <TextBlock x:Name="ZoneAuditStatus" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Face-down traps (optional)" Margin="0,0,0,10">
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Text="Manual watch until card-back/flip recognition is calibrated. Unknown traps never invent an exact identity or provision cost. Spring can be used manually; elapsed seconds are not a trigger." FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                                        <WrapPanel Margin="0,5"><Button Content="Add face-down trap" Click="AddHiddenTrap_OnClick"/><Button Content="Removed / banished" Click="RemoveHiddenTrap_OnClick"/></WrapPanel>
                                        <ComboBox x:Name="HiddenTrapChoice" Foreground="#E8E0CC" SelectionChanged="HiddenTrapChoice_OnChanged"/>
                                        <ComboBox x:Name="TrapTriggerChoice" Foreground="#E8E0CC" Margin="0,4"/>
                                        <Button Content="Still face down after verified trigger" Click="TrapSurvived_OnClick"/>
                                        <TextBlock x:Name="TrapCandidatesText" FontSize="10" TextWrapping="Wrap" Margin="0,5"/>
                                        <ComboBox x:Name="TrapIdentityChoice" Foreground="#E8E0CC" ItemTemplate="{StaticResource CardChoiceText}" ItemContainerStyle="{StaticResource CardChoiceItems}" MaxDropDownHeight="180"/>
                                        <Button Content="Record revealed identity" Click="RevealTrap_OnClick"/>
                                    </StackPanel>
                                </Expander>
                                <TextBlock x:Name="MetaSampleText" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="UnseenForecastText" Margin="0,8,0,0" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Margin="0,14,0,5" Text="SPECIFIC TO THESE PLAYS" Foreground="#85BFFF" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StrategyEmptyText" FontSize="11" TextWrapping="Wrap" Text="Not enough repeated co-occurrence evidence for a distinctive strategy yet." Foreground="{StaticResource MutedTextBrush}"/>
                                <ItemsControl x:Name="StrategySignalList" ItemTemplate="{StaticResource MetaSignalTemplate}"/>
                                <TextBlock Margin="0,14,0,5" Text="POPULAR IN RECENT CACHED LISTS" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                <ItemsControl x:Name="PopularSignalList" ItemTemplate="{StaticResource MetaSignalTemplate}"/>
                            </StackPanel>
                        </ScrollViewer></Grid>
<Grid x:Name="MyDeckPage" Visibility="Collapsed"><Grid Margin="5,8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock x:Name="UserReferenceSummary" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                            <WrapPanel Grid.Row="1" Margin="0,8,0,8">
                            <Button Content="Choose / change my deck" Click="ChooseOwnReference_OnClick" Padding="7,4" FontSize="11"/>
                            <Button x:Name="ClearMyReferenceButton" Content="Unpin" Click="ClearSelectedUserDeckButton_OnClick" Padding="7,4" FontSize="11" IsEnabled="False"/>
                            </WrapPanel>
                            <ui:DeckCardList x:Name="UserReferenceCards" Grid.Row="2"/>
                        </Grid></Grid>
<Grid x:Name="AuditPage" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="7,8">
                                <TextBlock x:Name="LiveViewText" FontWeight="SemiBold" Text="Waiting for capture"/>
                                <TextBlock x:Name="LiveDetailText" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="DetectedPlayText" TextWrapping="Wrap" Margin="0,6,0,10" Foreground="{StaticResource AccentBrush}" Text="No preview episodes yet."/>
                                <TextBlock Text="Opponent evidence (includes generated / unknown origins)" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="OpponentCandidatesText" TextWrapping="Wrap" Margin="0,4,0,8" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="OpponentCardsText" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock Text="Player observations · training / audit only" FontWeight="SemiBold" Margin="0,15,0,5"/>
                                <TextBlock x:Name="UserCandidatesText" TextWrapping="Wrap"/>
                                <TextBlock x:Name="UserCardsText" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </ScrollViewer></Grid>
<Grid x:Name="MemoryPage" Visibility="Collapsed"><Grid Margin="6,8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="MemoryStatusText" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Saved partial encounters are not complete meta decks. Unrecorded cards remain possible; only verified conflicts reject a match." FontSize="10" TextWrapping="Wrap" Margin="0,5,0,6" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBox x:Name="MemoryNameInput" Text="Learned opponent deck" Padding="5" Background="#11151A" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                                <CheckBox x:Name="MemoryCompleteChoice" Content="I reviewed every original card and copy" Foreground="{StaticResource TextBrush}" Margin="0,7,0,6"/>
                                <DockPanel Margin="0,0,0,6"><TextBlock DockPanel.Dock="Left" Text="Faction MMR (auto / override)" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10"/>
                                    <TextBox x:Name="MatchMmrInput" Width="75" HorizontalAlignment="Left" Padding="4" Background="#11151A" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"
                                             ToolTip="Optional faction MMR for this match."/>
                                </DockPanel>
                                <TextBlock x:Name="MatchMmrStatus" Visibility="Collapsed" TextWrapping="Wrap" FontSize="10" Margin="0,0,0,6" Foreground="{StaticResource AccentBrush}"/>
                                <WrapPanel><Button Content="Save / merge exact duplicate" Click="SaveOpponentMemory_OnClick"/><Button Content="Add to selected memory" Click="MergeOpponentMemory_OnClick"/></WrapPanel>
                            </StackPanel>
                            <ListBox x:Name="OpponentMemoryList" Grid.Row="1" Background="#11151A" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OpponentMemoryList_OnChanged">
                                <ListBox.ItemTemplate><DataTemplate><ui:DeckHeading Title="{Binding Deck.Name}" Subtitle="{Binding Summary}" Faction="{Binding Deck.Faction}" Leader="{Binding Deck.Leader}"/></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock x:Name="MemoryDetailText" TextWrapping="Wrap" FontSize="10" MaxHeight="80" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}"/>
                                <WrapPanel Margin="0,5,0,0"><Button Content="Inspect memory" Click="InspectMemory_OnClick"/><Button Content="Edit / rename" Click="EditLearnedMemory_OnClick"/><Button Content="Use unseen cards as guesses" Click="UseMemoryGuesses_OnClick"/></WrapPanel>
                            </StackPanel>
                        </Grid></Grid>
</Grid></Grid></Grid>
<TextBlock x:Name="FooterStatusText" Grid.Row="5" Margin="0,6,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Text="Ready"/>
<Border x:Name="LoadingShell" Grid.RowSpan="6" Panel.ZIndex="100" Background="#171B20" BorderBrush="#5B4A29" BorderThickness="1">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
<TextBlock Text="G W E N T" FontFamily="Georgia" FontSize="42" FontWeight="Bold" Foreground="#E5C77E" HorizontalAlignment="Center"/>
<Border Height="1" Width="250" Background="#8E7138" Margin="0,3,0,3"/>
<TextBlock Text="V  I  S  I  O  N" FontFamily="Georgia" FontSize="18" Foreground="#B7C8BE" HorizontalAlignment="Center"/>
</StackPanel>
<StackPanel Grid.Row="2" Margin="0,32,0,0">
<ProgressBar x:Name="LoadingProgress" Height="4" IsIndeterminate="True" Foreground="#C9A75B" Background="#252D2A" BorderThickness="0"/>
<TextBlock x:Name="LoadingStatusText" Text="Opening local intelligence cache…" FontSize="10" Foreground="#AEB7B0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
</StackPanel>
</Grid></Border>
</Grid></Window>
