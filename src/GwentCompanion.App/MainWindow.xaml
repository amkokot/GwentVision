<Window x:Class="GwentCompanion.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:GwentCompanion.App.Controls"
        Title="Gwent Vision 0.2" Width="410" Height="860" MinWidth="370" MinHeight="620"
 Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" SizeChanged="Window_OnSizeChanged" KeyDown="Workspace_OnKeyDown" WindowStartupLocation="Manual">
    <Window.Resources>
        <DataTemplate x:Key="CardChoiceText"><TextBlock Text="{Binding Name}" Foreground="#E8E0CC"/></DataTemplate>
        <DataTemplate x:Key="PlainChoiceText"><TextBlock Text="{Binding}" Foreground="#E8E0CC" TextTrimming="CharacterEllipsis"/></DataTemplate>
        <DataTemplate x:Key="EffectChoiceText"><TextBlock Text="{Binding Label}" Foreground="#E8E0CC" TextWrapping="Wrap" MaxWidth="285" FontSize="11"/></DataTemplate>
        <Style x:Key="CardChoiceItems" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        </Style>
        <Style x:Key="EffectChoiceItems" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
        </Style>
    
<Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
<Setter Property="Width" Value="32"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="5"/><Setter Property="Margin" Value="3,0,0,0"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
<Border x:Name="IconFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
<ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="IconFrame" Property="Background" Value="#354038"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="IconFrame" Property="BorderBrush" Value="#E5C77E"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="IconFrame" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
</ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="NavigationButton" TargetType="RadioButton">
<Setter Property="Foreground" Value="#C9CECA"/><Setter Property="Padding" Value="7,9"/><Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Frame" Background="#1C2325" BorderBrush="#47534D" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
<ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#C9A75B"/><Setter TargetName="Frame" Property="BorderThickness" Value="0,0,0,2"/><Setter TargetName="Frame" Property="Background" Value="#303A33"/><Setter Property="Foreground" Value="#E5C77E"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#354038"/></Trigger></ControlTemplate.Triggers>
</ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="PlaySynergyButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
<Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="Auto"/><Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="0,0,5,5"/><Setter Property="FontSize" Value="11"/>
</Style>
<Style x:Key="OptionalThreatText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
<Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
</Style>
</Window.Resources>
<Grid x:Name="WindowLayout" Margin="12">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel x:Name="BrandHeader" Margin="0,0,0,6">
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
<Button x:Name="WorkspaceDisplayButton" Visibility="Collapsed" Style="{StaticResource IconButton}" Click="WorkspaceDisplay_OnClick" Content="▤" ToolTip="Full screen, monitor and text size" AutomationProperties.Name="Workspace display options"/>
<Button x:Name="WorkspaceToggle" Style="{StaticResource IconButton}" Click="WorkspaceToggle_OnClick" ToolTip="Expanded workspace · F11 for full screen" AutomationProperties.Name="Expand workspace"><Path x:Name="WorkspaceToggleIcon" Data="M 6,1 L 1,1 L 1,6 M 10,1 L 15,1 L 15,6 M 1,10 L 1,15 L 6,15 M 10,15 L 15,15 L 15,10" Stroke="#DCC58D" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform"/></Button>
<Button x:Name="DiagnosticButton" Style="{StaticResource IconButton}" Click="DiagnosticButton_OnClick" ToolTip="Start or stop live analysis" AutomationProperties.Name="Start analysis"><Path x:Name="AnalysisIcon" Data="M 2,1 L 14,8 L 2,15 Z" Fill="#8BDCAB" Stretch="Uniform" Width="14" Height="16"/></Button>
<Button x:Name="SnapshotButton" Style="{StaticResource IconButton}" Click="Camera_OnClick" IsEnabled="False" ToolTip="Capture and pin game view" AutomationProperties.Name="Capture and pin"><Path Data="M 1,4 L 4,4 L 6,1 L 12,1 L 14,4 L 17,4 L 17,14 L 1,14 Z M 12,9 A 3,3 0 1 1 6,9 A 3,3 0 1 1 12,9" Stroke="#DCC58D" StrokeThickness="1.5" Stretch="Uniform" Width="16" Height="16"/></Button>
<Button x:Name="PinnedButton" Style="{StaticResource IconButton}" Tag="Pinned" Click="Navigate_OnClick" ToolTip="Pinned views" AutomationProperties.Name="Pinned views"><Path Data="M 4,1 L 12,1 L 10,4 L 10,8 L 13,11 L 8,11 L 8,17 L 7,17 L 7,11 L 2,11 L 5,8 L 5,4 Z" Fill="#DCC58D" Stretch="Uniform" Width="16" Height="16"/></Button>
<Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Tag="Settings" Click="Navigate_OnClick" ToolTip="Settings" AutomationProperties.Name="Settings"><TextBlock Text="⚙" Foreground="#DCC58D" FontSize="19" VerticalAlignment="Center"/></Button>
</StackPanel>
<TextBlock x:Name="BrandTitle" Text="GWENT VISION" FontFamily="Georgia" FontSize="16" FontWeight="Bold" Foreground="#E5C77E" VerticalAlignment="Center"/>
</DockPanel>
<Border x:Name="GameStatusPanel" Grid.Row="1" Padding="1,2" Margin="0,0,0,8">
<StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><CheckBox x:Name="RecordTrainingChoice" Content="REC" IsChecked="False" Checked="RecordingChoice_OnChanged" Unchecked="RecordingChoice_OnChanged" FontSize="10" Foreground="#E8867B" Margin="8,0,0,0" ToolTip="Save training screenshots." AutomationProperties.Name="Record training footage"/><CheckBox x:Name="DetailedReachChoice" Visibility="Collapsed" Content="Detailed Reach" IsChecked="False" Checked="DetailedReach_OnChanged" Unchecked="DetailedReach_OnChanged" FontSize="10" Foreground="#DCC58D" Margin="8,0,0,0" AutomationProperties.Name="Detailed Reach"/></StackPanel><Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#77808A" Margin="0,0,6,0"/><TextBlock x:Name="GameStatusText" Text="Looking for GWENT…" FontSize="10" TextTrimming="CharacterEllipsis"/></DockPanel>
<TextBlock x:Name="AnalysisStatusText" Visibility="Collapsed" Margin="0,3,0,0" FontSize="10" Foreground="#DCC58D" TextWrapping="Wrap"/></StackPanel>
</Border>
<RadioButton x:Name="LibraryNavigation" Grid.Row="2" GroupName="MainNavigation" Style="{StaticResource NavigationButton}" Tag="Library" Checked="Navigate_OnClick" Margin="0,0,0,8" AutomationProperties.Name="Library">
<StackPanel Orientation="Horizontal"><Path Data="M 8,3 Q 4,0 0,2 L 0,14 Q 4,12 8,15 Q 12,12 16,14 L 16,2 Q 12,0 8,3 L 8,15" Stroke="#DCC58D" StrokeThickness="1.5" Stretch="Uniform" Width="16" Height="16"/><TextBlock Text="  LIBRARY" FontFamily="Georgia" Foreground="#DCC58D" FontSize="13"/></StackPanel>
</RadioButton>
<UniformGrid x:Name="GameplayNavigation" Grid.Row="3" Columns="2" Margin="0,0,0,7">
<RadioButton x:Name="AnalysisNavigation" GroupName="MainNavigation" Style="{StaticResource NavigationButton}" Content="Analysis" Tag="Deck" Checked="Navigate_OnClick" AutomationProperties.Name="Analysis workspace"/>
<RadioButton x:Name="ReferenceNavigation" GroupName="MainNavigation" Style="{StaticResource NavigationButton}" Content="Reference" Tag="Reference" Checked="Navigate_OnClick" AutomationProperties.Name="Reference"/>
</UniformGrid>
<Grid x:Name="WorkspaceBody" Grid.Row="4">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<ScrollViewer x:Name="HoverThreatViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
<Border x:Name="HoverThreatBanner" Visibility="Collapsed" Background="#20312B" BorderBrush="#A78A50" BorderThickness="1" Padding="7" Margin="0,0,0,6" AutomationProperties.Name="Hover Reach">
<StackPanel>
<DockPanel><Button DockPanel.Dock="Right" Content="×" Style="{StaticResource IconButton}" Width="22" Height="22" Padding="1" Click="DismissHoverThreat_OnClick" ToolTip="Hide until the hovered card changes" AutomationProperties.Name="Dismiss hover threats"/>
<Button x:Name="ThreatChooseButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="22" Height="22" Padding="3" Click="ToggleThreatChoice_OnClick" ToolTip="Choose a reference card instead of following the game hover" AutomationProperties.Name="Choose reference card"><Path Data="M 2,1 L 12,1 L 12,15 L 2,15 Z M 5,5 L 9,5 M 5,8 L 9,8 M 5,11 L 8,11" Stroke="#DCC58D" StrokeThickness="1.2" Width="10" Height="14" Stretch="Uniform"/></Button>
<TextBlock x:Name="HoverThreatTitle" FontSize="12" Foreground="#E5D6AC" TextWrapping="Wrap"/></DockPanel>
<TextBlock x:Name="HoverThreatSummary" Style="{StaticResource OptionalThreatText}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
<StackPanel x:Name="ReachProgressPanel" Visibility="Collapsed" Margin="0,5,0,2">
<ProgressBar x:Name="ReachProgressBar" Height="4" Minimum="0" Maximum="1" Value="0" Foreground="#86C98B" Background="#39453D" AutomationProperties.Name="Reach evaluation progress"/>
<TextBlock x:Name="ReachProgressText" FontSize="9" Foreground="#A6B8AF" TextWrapping="Wrap" Margin="0,3,0,0"/>
</StackPanel>
<TextBlock x:Name="HoverThreatWarning" FontSize="9" Foreground="#BBC2BF" TextWrapping="Wrap" Margin="0,4,0,0"/>
<StackPanel x:Name="HoverThreatHorizons" Visibility="Collapsed" Margin="0,4,0,1">
<TextBlock Text="CARD  |  +1 TURN  |  +2 TURNS / PASS" FontSize="8" Foreground="#788580"/>
<StackPanel Orientation="Horizontal">
<TextBlock x:Name="HoverThreatImmediate" FontSize="16" FontWeight="SemiBold" Foreground="#E5C77E" ToolTip="Card body and direct effect only"/>
<TextBlock Text="  |  " FontSize="15" Foreground="#67716D"/>
<TextBlock x:Name="HoverThreatOneTurn" FontSize="16" FontWeight="SemiBold" Foreground="#79BFD4" ToolTip="Card plus first engine, Vitality/Bleeding and weather window"/>
<TextBlock Text="  |  " FontSize="15" Foreground="#67716D"/>
<TextBlock x:Name="HoverThreatTwoTurn" FontSize="16" FontWeight="SemiBold" Foreground="#86C98B" ToolTip="Cumulative second window; automatic pass-safe growth only"/>
</StackPanel>
</StackPanel>
<TextBlock x:Name="HoverThreatRange" Style="{StaticResource OptionalThreatText}" FontSize="10" Foreground="#A9C9DA" TextWrapping="Wrap" Margin="0,3,0,0"/>
<StackPanel x:Name="ThreatChoicePanel" Visibility="Collapsed" Margin="0,5,0,3">
<TextBlock x:Name="ThreatChoiceHelp" Text="Choose from My deck; selection does not confirm a card is in hand." FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
<ComboBox x:Name="ThreatCardChoice" ItemTemplate="{StaticResource CardChoiceText}" ItemContainerStyle="{StaticResource CardChoiceItems}" SelectionChanged="ThreatCardChoice_OnChanged" AutomationProperties.Name="Reference card for estimate" Margin="0,4"/>
</StackPanel>
<Button x:Name="FollowHoverButton" Content="Manual selection · follow hover ↩" Click="ClearThreatChoice_OnClick" Style="{StaticResource PlaySynergyButton}" Padding="5,2" FontSize="10" HorizontalAlignment="Left" Visibility="Collapsed" AutomationProperties.Name="Follow game hover"/>
<Border x:Name="ThreatDetailPanel" Visibility="Collapsed" Background="#1B2422" Padding="6" Margin="0,5,0,3">
<StackPanel>
<TextBlock x:Name="ThreatExtendedSummaryText" Style="{StaticResource OptionalThreatText}" FontSize="10" Foreground="#E1CC9C" TextWrapping="Wrap"/>
<TextBlock x:Name="HoverThreatLeaderDetail" Style="{StaticResource OptionalThreatText}" FontSize="10" Foreground="#D6BB8A" TextWrapping="Wrap" Margin="0,3,0,3"/>
<TextBlock Text="Opponent replies" FontSize="10" FontWeight="SemiBold" Foreground="#B1D4BE" Margin="0,3,0,2"/>
<ScrollViewer MaxHeight="165" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="HoverThreatDetailReplies"><ItemsControl.ItemTemplate><DataTemplate>
<Border BorderBrush="#39453D" BorderThickness="0,0,0,1" Padding="2,4"><StackPanel>
<TextBlock Text="{Binding Heading}" Foreground="#E5D6AC" TextWrapping="Wrap" FontSize="10"/>
<StackPanel Orientation="Horizontal" Visibility="{Binding HorizonVisibility}" Margin="0,2,0,0">
<TextBlock Text="{Binding Immediate}" Foreground="#E5C77E" FontSize="10" FontWeight="SemiBold"/>
<TextBlock Text="  |  " Foreground="#67716D" FontSize="10"/>
<TextBlock Text="{Binding OneTurn}" Foreground="#79BFD4" FontSize="10" FontWeight="SemiBold"/>
<TextBlock Text="  |  " Foreground="#67716D" FontSize="10"/>
<TextBlock Text="{Binding TwoTurns}" Foreground="#86C98B" FontSize="10" FontWeight="SemiBold" Opacity="{Binding TwoTurnOpacity}"/>
</StackPanel>
</StackPanel></Border>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
<TextBlock x:Name="ThreatDetailText" Visibility="Collapsed"/>
<StackPanel x:Name="PlayerStatisticsPanel" Visibility="Collapsed" Margin="0,5,0,3">
<TextBlock x:Name="PlayerStatisticsText" FontSize="10" TextWrapping="Wrap" Foreground="#A9C9DA"/>
<ui:PointHistogram x:Name="PlayerHistogram" Height="76"/>
</StackPanel>
<Expander x:Name="ThreatStatisticsExpander" Header="RNG / Create estimates" Visibility="Collapsed" FontSize="11" Margin="0,4">
<ItemsControl x:Name="ThreatStatisticsList"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="2,6">
<TextBlock Text="{Binding Heading}" FontSize="11" Foreground="#E5D6AC" TextWrapping="Wrap"/>
<ui:PointHistogram Distribution="{Binding Distribution}" Threshold="{Binding Threshold}" Height="72" Visibility="{Binding ChartVisibility}"/>
</StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</Expander></StackPanel>
</Border>
</StackPanel></Border></ScrollViewer>
<Grid Grid.Row="1">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<DockPanel x:Name="PageBackBar" Visibility="Collapsed" Margin="0,0,0,6"><Button x:Name="BackToGameButton" Content="‹ Back to game" Padding="6,3" Margin="0" Click="BackToGame_OnClick"/><TextBlock x:Name="AuxiliaryPageTitle" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" Foreground="#C9A75B"/></DockPanel>
<UniformGrid x:Name="LiveModeBar" Grid.Row="1" Columns="3" Margin="5,0,5,7">
<RadioButton x:Name="LiveOverviewNavigation" GroupName="LiveMode" Style="{StaticResource NavigationButton}" Content="Overview" Padding="7,5" FontSize="11" Tag="Plays" Checked="Navigate_OnClick" Visibility="Collapsed"/>
<RadioButton x:Name="LiveOpponentNavigation" GroupName="LiveMode" Style="{StaticResource NavigationButton}" Content="Opponent" Padding="7,5" FontSize="11" Tag="Deck" Checked="Navigate_OnClick"/>
<RadioButton x:Name="LiveCandidatesNavigation" GroupName="LiveMode" Style="{StaticResource NavigationButton}" Content="Candidates" Padding="7,5" FontSize="11" Tag="Candidates" Checked="Navigate_OnClick"/>
<RadioButton x:Name="LiveSnapshotsNavigation" GroupName="LiveMode" Style="{StaticResource NavigationButton}" Content="Snapshots" Padding="7,5" FontSize="11" Tag="Pinned" Checked="Navigate_OnClick"/>
</UniformGrid>
<UniformGrid x:Name="ReferenceModeBar" Grid.Row="1" Columns="2" Visibility="Collapsed" Margin="5,0,5,7">
<RadioButton x:Name="ReferenceDeckNavigation" GroupName="ReferenceNavigation" Style="{StaticResource NavigationButton}" Content="Opponent" Padding="7,5" FontSize="11" Tag="Reference" Checked="ReferenceMode_OnChanged" AutomationProperties.Name="Opponent deck"/>
<RadioButton x:Name="ReferenceMyDeckNavigation" GroupName="ReferenceNavigation" Style="{StaticResource NavigationButton}" Content="My deck" Padding="7,5" FontSize="11" Tag="MyDeck" Checked="ReferenceMode_OnChanged" AutomationProperties.Name="My deck"/>
</UniformGrid>
<Grid x:Name="Pages" Grid.Row="2">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
<UniformGrid x:Name="WorkspaceLaneHeadings" Grid.ColumnSpan="3" Columns="3" Visibility="Collapsed" Margin="5,0,5,10">
<TextBlock x:Name="FirstLaneTitle" Text="OPPONENT DECK" FontFamily="Georgia" FontSize="16" Foreground="#E5C77E"/>
<TextBlock x:Name="SecondLaneTitle" Text="CANDIDATE CARDS" FontFamily="Georgia" FontSize="16" Foreground="#E5C77E" Margin="12,0,0,0"/>
<TextBlock x:Name="ThirdLaneTitle" Text="SNAPSHOTS" FontFamily="Georgia" FontSize="16" Foreground="#E5C77E" Margin="12,0,0,0"/>
</UniformGrid>
<Grid x:Name="PlaysPage">
<ScrollViewer x:Name="PlaysScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel Margin="5,5,5,8">
<Border Background="#182422" BorderBrush="#3E5148" BorderThickness="1" Padding="8,6" Margin="0,0,0,6">
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="YOU" FontSize="9" Foreground="#91B9A7"/><TextBlock x:Name="UserSpentText" Text="Spent 0p" FontSize="12" Foreground="#E5D6AC"/><TextBlock x:Name="UserRemainingText" Text="Remaining not read" FontSize="10" TextWrapping="Wrap" Foreground="#E5D6AC"/><TextBlock x:Name="UserCarryText" Text="Carryover 0" FontSize="11" TextWrapping="Wrap" Foreground="#85D7B1"/></StackPanel>
<StackPanel Grid.Column="1"><TextBlock Text="OPPONENT" FontSize="9" Foreground="#91B9A7"/><TextBlock x:Name="OpponentSpentText" Text="Spent 0p" FontSize="12" Foreground="#E5D6AC"/><TextBlock x:Name="OpponentRemainingText" Text="Remaining not read" FontSize="10" TextWrapping="Wrap" Foreground="#E5D6AC"/><TextBlock x:Name="OpponentCarryText" Text="Carryover 0" FontSize="11" TextWrapping="Wrap" Foreground="#85D7B1"/></StackPanel>
</Grid></Border>
<StackPanel x:Name="SynergyHistory" Visibility="Collapsed">
<Button x:Name="SpyingMemoryButton" Visibility="Collapsed" Content="NG Spying · 0" Click="SpyingMemory_OnClick" HorizontalAlignment="Left"
        Padding="8,4" Margin="0,0,0,5" Background="#38283F" Foreground="#D9B5E8" BorderBrush="#745D7E"
        ToolTip="Units remembered as having received Spying; used by Artaud Terranova reach" AutomationProperties.Name="Open NG Spying memory"/>
<Border x:Name="SpyingMemoryPanel" Visibility="Collapsed" Background="#211A26" BorderBrush="#654E70" BorderThickness="1" Padding="7" Margin="0,0,0,6">
<StackPanel>
<TextBlock Text="Artaud memory · distinct unit identities" FontSize="11" Foreground="#D9B5E8"/>
<TextBlock Text="Automatically remembered from visible Spying statuses. Add an identity here if vision missed it." TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,4"/>
<ItemsControl x:Name="SpyingMemoryList"><ItemsControl.ItemTemplate><DataTemplate>
<TextBlock Text="{Binding Heading}" FontSize="10" Foreground="#E5D6AC" Margin="1,2" TextWrapping="Wrap"/>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<ComboBox x:Name="SpyingSideChoice" SelectedIndex="1" ItemTemplate="{StaticResource PlainChoiceText}" Margin="0,5,0,2"/>
<ComboBox x:Name="SpyingCardChoice" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
          ItemTemplate="{StaticResource CardChoiceText}" ItemContainerStyle="{StaticResource CardChoiceItems}" MaxDropDownHeight="220"/>
<Button Content="Add missed Spying unit" Click="AddSpyingMemory_OnClick" Padding="6,3" Margin="0,3,0,0" HorizontalAlignment="Left"/>
<TextBlock x:Name="SpyingMemoryStatus" FontSize="9" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
</StackPanel></Border>
<Button x:Name="BountyMemoryButton" Visibility="Collapsed" Content="Bounty · 0 / 0 / 0" Click="BountyMemory_OnClick" HorizontalAlignment="Left"
        Padding="8,4" Margin="0,0,0,5" Background="#3B3020" Foreground="#E9CA75" BorderBrush="#7B6740"
        ToolTip="Destroyed Bounty base power / placements / maximum base power" AutomationProperties.Name="Open Bounty history"/>
<Border x:Name="BountyMemoryPanel" Visibility="Collapsed" Background="#292318" BorderBrush="#78643D" BorderThickness="1" Padding="7" Margin="0,0,0,6">
<StackPanel>
<TextBlock Text="Bounty history" FontSize="11" Foreground="#E9CA75"/>
<TextBlock Text="These values feed Ignatius Hale and The Brute. Record the side that placed the Bounties." TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,4"/>
<ComboBox x:Name="BountySideChoice" SelectedIndex="1" SelectionChanged="BountySide_OnChanged" ItemTemplate="{StaticResource PlainChoiceText}"><ComboBoxItem Content="You"/><ComboBoxItem Content="Opponent"/></ComboBox>
<TextBlock Text="Total base power of destroyed Bounty units" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,1"/><TextBox x:Name="BountyTotalBaseText" Text="0"/>
<TextBlock Text="Total Bounty placements" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,1"/><TextBox x:Name="BountyPlacementsText" Text="0"/>
<TextBlock Text="Maximum destroyed base power" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,1"/><TextBox x:Name="BountyMaximumBaseText" Text="0"/>
<Button Content="Record Bounty history" Click="RecordBountyMemory_OnClick" Padding="6,3" Margin="0,4,0,0" HorizontalAlignment="Left"/>
<TextBlock x:Name="BountyMemoryStatus" FontSize="9" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
</StackPanel></Border>
</StackPanel>
<Expander x:Name="CarryoverExpander" Header="Carryover · details / review" FontSize="11" Margin="0,0,0,6">
<StackPanel Margin="2,5"><TextBlock Text="Potential points, not a guarantee. Expand only to review sources. Stored souls and growing cards are separate." TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
<ItemsControl x:Name="CarryoverList"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,4">
<Button DockPanel.Dock="Right" Content="✓" Tag="{Binding Id}" Click="RealizeCarryover_OnClick" Padding="5,1" ToolTip="Mark realized or removed; can be undone" AutomationProperties.Name="Settle pending value"/>
<TextBlock Text="{Binding Heading}" FontSize="11" TextWrapping="Wrap"/>
</DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<Button Content="Undo last ledger change" Click="UndoCarryover_OnClick" Padding="5,2" HorizontalAlignment="Left" FontSize="10"/>
<Expander Header="Record a visible value / effect" FontSize="10" Margin="0,4"><StackPanel>
<ComboBox x:Name="LedgerSideChoice" SelectedIndex="1" ItemTemplate="{StaticResource PlainChoiceText}"/>
<ComboBox x:Name="LedgerKindChoice" SelectedIndex="0" ItemTemplate="{StaticResource PlainChoiceText}"/>
<ComboBox x:Name="LedgerCardChoice" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name" ItemTemplate="{StaticResource CardChoiceText}" ItemContainerStyle="{StaticResource CardChoiceItems}"/>
<TextBox x:Name="LedgerAmountText" Text="2" ToolTip="Points, current value, or verified refunded coins"/>
<ComboBox x:Name="LedgerTargetChoice" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name" ItemTemplate="{StaticResource CardChoiceText}" ItemContainerStyle="{StaticResource CardChoiceItems}" ToolTip="Optional buff target; required for Sword's captured unit"/>
<Button Content="Record reviewed observation" Click="RecordLedger_OnClick" Padding="5,3"/>
<TextBlock x:Name="LedgerReviewStatus" Text="Select side, effect and source. A Tribute refund must be distinguished from Profit or other coin gains." TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource MutedTextBrush}"/>
</StackPanel></Expander></StackPanel></Expander>
<Expander x:Name="GrowingValuesExpander" Header="Card values · stored effects" IsExpanded="True" Visibility="Collapsed" FontSize="11" Margin="0,0,0,5">
<ItemsControl x:Name="GrowingCardList" Margin="0,4,0,0"><ItemsControl.ItemTemplate><DataTemplate>
<Border Background="#1B2A25" BorderBrush="#456453" BorderThickness="0,0,0,1" Padding="6,4" Margin="0,0,0,2" AutomationProperties.HelpText="{Binding Detail}"><DockPanel>
<TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Foreground="#85D7B1" FontWeight="SemiBold" FontSize="11" Margin="6,0,0,0" MaxWidth="145" TextTrimming="CharacterEllipsis"/>
<TextBlock Text="{Binding Heading}" FontSize="11" TextTrimming="CharacterEllipsis"/>
</DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
<TextBlock x:Name="PlaysContextText" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,5"/>
<DockPanel Margin="0,0,0,6">
