<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>GwentVision</AssemblyName>
    <RootNamespace>GwentCompanion.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <ProjectReference Include="..\GwentCompanion.Core\GwentCompanion.Core.csproj" />
    <ProjectReference Include="..\GwentCompanion.Platform.Windows\GwentCompanion.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
