<Window x:Class="GwentCompanion.App.DataContributionConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gwent Vision · Share match data" Width="540" Height="440"
        MinWidth="460" MinHeight="400" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#101619" Foreground="#EEE8D9">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="HELP IMPROVE GWENT BALANCE" FontFamily="Georgia" FontSize="23" Foreground="#D6B664"/>
            <TextBlock Text="Share anonymized match results" FontSize="14" Foreground="#91B9A7" Margin="0,5,0,16"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="ConsentSummaryText"
                           Text="Help turn real match results into stronger, evidence-based Balance Council recommendations."
                           TextWrapping="Wrap" FontSize="14" LineHeight="21"/>

                <Border Background="#172420" BorderBrush="#4A6A5A" BorderThickness="1" Padding="12" Margin="0,15,0,14">
                    <StackPanel>
                        <TextBlock Text="ANONYMOUS AND PRIVATE" Foreground="#8BDCAB" FontFamily="Georgia" FontSize="13"/>
                        <TextBlock x:Name="PrivateRecordSummaryText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#D8E1DD" LineHeight="18"
                                   Text="Your submitted match records are anonymized, available only to designated analysts, and never published."/>
                    </StackPanel>
                </Border>

                <Expander x:Name="PrivacyDetails" Header="Privacy details and sharing options" IsExpanded="False" Foreground="#D6B664">
                    <StackPanel Margin="8,8,4,4">
                        <TextBlock Text="Shared privately: game date and approximate time, patch, result, round scores, rank or confirmed faction MMR, selected deck, observed and inferred opponent cards, detector version, and confidence markers."
                                   TextWrapping="Wrap" Foreground="#CAD2D0" FontSize="11" LineHeight="16"/>
                        <TextBlock Text="Never collected: your player name or Gwent account. A private random installation identity prevents duplicate uploads."
                                   TextWrapping="Wrap" Foreground="#AEB7C0" FontSize="11" LineHeight="16" Margin="0,8,0,12"/>

                        <CheckBox x:Name="PublishCurveChoice" IsChecked="True" Foreground="#EEF2F5" Margin="0,1,0,4">
                            <TextBlock Text="Publish my anonymous monthly MMR curve" TextWrapping="Wrap"/>
                        </CheckBox>
                        <TextBlock Text="Only a separate seasonal code, rounded times, faction, and rating reach the public chart. Match records and deck information remain private."
                                   TextWrapping="Wrap" Foreground="#AEB7C0" FontSize="11" LineHeight="16" Margin="22,0,0,12"/>

                        <CheckBox x:Name="AutomaticUploadChoice" IsChecked="True" Foreground="#EEF2F5" Margin="0,1,0,4">
                            <TextBlock Text="Share once monthly after the 18th" TextWrapping="Wrap"/>
                        </CheckBox>
                        <TextBlock Text="The first match you play after the 18th triggers one upload. Change either option later in Settings."
                                   TextWrapping="Wrap" Foreground="#AEB7C0" FontSize="11" LineHeight="16" Margin="22,0,0,4"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="You can change this later in Settings." VerticalAlignment="Center" Foreground="#87938F" FontSize="10"/>
            <Button Grid.Column="1" Content="Keep data local" Click="KeepLocal_OnClick" Padding="14,8"/>
            <Button Grid.Column="2" Content="Share match data" Click="Share_OnClick" IsDefault="True" Padding="14,8" BorderBrush="#C49B46"/>
        </Grid>
    </Grid>
</Window>
